FROM node:22-alpine AS web
WORKDIR /build
COPY web/package.json web/package-lock.json* ./
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund
COPY web/ ./
RUN npm run build

FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/gateway ./cmd/browcord-gateway

FROM alpine:3.21
RUN apk add --no-cache ca-certificates wget && adduser -D -u 10001 browcord
WORKDIR /app
COPY --from=build /out/gateway /app/gateway
COPY --from=web /build/dist /app/web/dist
USER browcord
EXPOSE 8080
ENTRYPOINT ["/app/gateway"]
